{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git branch -a -vv)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push *-uf*)",
      "Bash(git push *--force*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/main)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
